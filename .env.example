# ┌─────────────────────────────────────────────────────────────────┐
# │  SyncPad — Environment Variables                               │
# │  Copy this file:  cp .env.example .env                         │
# │  Then edit the values below to match your local setup.         │
# └─────────────────────────────────────────────────────────────────┘

# === Database (PostgreSQL) ===
# Used by both docker-compose (for the db container) and the Go backend.
POSTGRES_USER=syncpad
POSTGRES_PASSWORD=syncpad123
POSTGRES_DB=syncpad

# === Backend (Go Server) ===
# DATABASE_URL — full connection string for PostgreSQL.
#   - Docker:  uses "db" as hostname (Docker service name)
#   - Local:   use "localhost" instead of "db"
DATABASE_URL=postgres://syncpad:syncpad123@db:5432/syncpad?sslmode=disable

# REDIS_URL — full connection string for Redis.
#   - Docker:  uses "redis" as hostname (Docker service name)
#   - Local:   use "localhost" instead of "redis"
#   IMPORTANT: must use redis:// protocol prefix (required by go-redis ParseURL)
REDIS_URL=redis://redis:6379

# SERVER_PORT — the port the Go backend listens on.
SERVER_PORT=3000

# APP_ENV — "development" or "production".
#   - development: WebSocket accepts connections from any origin.
#   - production:  WebSocket only accepts origins listed in ALLOWED_ORIGINS.
APP_ENV=development

# ALLOWED_ORIGINS — comma-separated list of allowed WebSocket origins.
# Only enforced when APP_ENV=production.
# Example: https://syncpad-frontend.example.com,https://syncpad.yourdomain.com
ALLOWED_ORIGINS=http://localhost:80,http://localhost:4200
