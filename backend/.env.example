# ┌─────────────────────────────────────────────────────────────────┐
# │  SyncPad — Backend Environment Variables (Local Dev)           │
# │  Copy this file:  cp .env.example .env                         │
# │  Used when running Go backend directly (not via Docker).       │
# └─────────────────────────────────────────────────────────────────┘

# Points to localhost because you're running PostgreSQL & Redis
# directly on your machine (or via `docker compose up db redis`).
DATABASE_URL=postgres://syncpad:syncpad123@localhost:5432/syncpad?sslmode=disable
REDIS_URL=redis://localhost:6379
SERVER_PORT=3000
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:4200
